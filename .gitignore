# ============================================================
# GrowPlus Monorepo .gitignore
# Node.js, Next.js, Flutter, Supabase, Docker
# ============================================================

# ---- Environment Files (NEVER commit secrets) ----
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production
*.env

# ---- Node.js / npm ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*
package-lock.json
yarn.lock
pnpm-lock.yaml

# ---- TypeScript Build Output ----
dist/
build/
*.tsbuildinfo
*.d.ts.map

# ---- Next.js ----
.next/
out/
.vercel
next-env.d.ts

# ---- Flutter / Dart ----
# General
*.apk
*.aab
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
*.iml

# Android specific
**/android/.gradle/
**/android/captures/
**/android/gradlew
**/android/gradlew.bat
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java
**/android/key.properties
**/*.keystore
**/*.jks

# iOS specific
**/ios/.symlinks/
**/ios/Flutter/flutter_export_environment.sh
**/ios/Flutter/Generated.xcconfig
**/ios/Pods/
**/ios/.generated/
**/ios/Runner.xcworkspace/xcshareddata/WorkspaceSettings.xcsettings

# macOS
**/macos/Flutter/GeneratedPluginRegistrant.swift
**/macos/Flutter/ephemeral/

# web
**/web/firebase-messaging-sw.js

# ---- Supabase ----
supabase/.branches/
supabase/.temp/

# ---- Logs ----
logs/
*.log
npm-debug.log*
lerna-debug.log*

# ---- Testing ----
coverage/
.nyc_output/
test-results/
playwright-report/
*.snap

# ---- IDEs & Editors ----
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ---- Docker ----
.docker/
docker-compose.override.yml

# ---- Miscellaneous ----
*.pem
*.key
*.p12
*.pfx
.cache/
tmp/
temp/
*.tmp
*.bak
*.orig
.turbo/
.changeset/
